// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "rhel-openssl-3.0.x", "rhel-openssl-1.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================
// USER & AUTHENTICATION
// ============================================

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  phone         String?   @unique
  firstName     String
  lastName      String
  avatar        String?
  password      String
  role          String    @default("CUSTOMER") // CUSTOMER, PROFESSIONAL, ADMIN
  isVerified    Boolean   @default(false)
  isActive      Boolean   @default(true)
  verificationToken String?
  tokenExpires  DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Client Address & Extensible Verification Fields
  permanentAddress          String?
  permanentAddressProof     String?
  permanentAddressStatus    String    @default("NOT_SUBMITTED") // NOT_SUBMITTED, PENDING, VERIFIED, REJECTED, SUSPENDED
  permanentAddressNotes     String?
  secondaryAddress          String?
  pendingPermanentAddress   String?
  pendingPermanentAddressProof String?
  bookingAddresses          String?   @default("[]") // JSON stringified array of booking addresses

  // Extensible Verification Framework Fields (NIN, Identity, Business)
  idVerified                Boolean   @default(false)
  ninNumber                 String?
  ninStatus                 String    @default("NOT_SUBMITTED") // NOT_SUBMITTED, PENDING, VERIFIED, REJECTED
  businessVerified          Boolean   @default(false)
  cacNumber                 String?

  // Relations
  professional  Professional?
  bookings      Booking[]     @relation("CustomerBookings")
  addresses     Address[]
  reviews       Review[]      @relation("CustomerReviews")
  wallet        Wallet?
  payments      Payment[]
  notifications Notification[]
  sessions      Session[]
  disputesRaised   Dispute[]  @relation("CustomerDisputes")
  disputesAssigned Dispute[]  @relation("AdminDisputes")
  replacementParts ReplacementPart[] @relation("CustomerParts")
  merchant         Merchant?
  marketplaceOrders MarketplaceOrder[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// PROFESSIONAL PROFILES
// ============================================

model Professional {
  id                 String    @id @default(cuid())
  userId             String    @unique
  digitalId          String?   @unique // Official unique Digital ID e.g. HHP-PRO-84920
  bio                String?
  skills             String    @default("[]") // JSON array stored as string
  yearsExperience    Int       @default(0)
  rating             Float     @default(0)
  totalJobs          Int       @default(0)
  isAvailable        Boolean   @default(true)
  verificationStatus String    @default("PENDING") // PENDING, VERIFIED, REJECTED
  documents          String    @default("{}") // JSON
  bankName           String?
  bankAccount        String?
  accountName        String?
  latitude           Float?
  longitude          Float?
  responseTime       Int?      // in minutes
  
  // Structured Verification & Audit
  idType             String?   // NIN, DRIVERS_LICENSE, PASSPORT, VOTERS_CARD
  idNumber           String?
  idUrl              String?   // Image/Doc URL
  addressProofUrl    String?   // Document URL
  bvn                String?
  addressVerified    Boolean   @default(false)
  verificationNotes  String?
  verifiedBy         String?
  verifiedAt         DateTime?

  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // Relations
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings Booking[] @relation("ProfessionalBookings")
  reviews  Review[]  @relation("ProfessionalReviews")
  services ProfessionalService[]
  disputes Dispute[]  @relation("ProfessionalDisputes")
  replacementParts ReplacementPart[] @relation("ProfessionalParts")
}

model ProfessionalService {
  id             String @id @default(cuid())
  professionalId String
  serviceId      String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  service      Service      @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([professionalId, serviceId])
}

// ============================================
// SERVICES
// ============================================

model ServiceCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  description String?
  order       Int       @default(0)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())

  services Service[]
}

model Service {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  icon        String?
  categoryId  String
  basePrice   Float
  priceUnit   String   @default("per service") // per service, per hour, per sqm
  isHighRisk  Boolean  @default(false)
  riskLevel   String   @default("LOW") // LOW, MEDIUM, HIGH
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // Relations
  category      ServiceCategory       @relation(fields: [categoryId], references: [id])
  bookings      Booking[]
  professionals ProfessionalService[]
  pricingRules  PricingRule[]
}

model PricingRule {
  id           String @id @default(cuid())
  serviceId    String
  propertyType String // HOME, APARTMENT, OFFICE, COMMERCIAL
  bedrooms     Int?
  bathrooms    Int?
  price        Float
  description  String?

  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@unique([serviceId, propertyType, bedrooms, bathrooms])
}

// ============================================
// BOOKINGS
// ============================================

model Booking {
  id             String   @id @default(cuid())
  reference      String   @unique @default(cuid())
  customerId     String
  professionalId String?
  serviceId      String
  status         String   @default("PENDING") // PENDING, ASSIGNED, ACCEPTED, EN_ROUTE, WORK_IN_PROGRESS, COMPLETED, CANCELLED, REFUNDED
  scheduledDate  DateTime
  scheduledTime  String
  propertyType   String   @default("HOME")
  bedrooms       Int?
  bathrooms      Int?
  address        String   // JSON
  landmark       String?
  specialNotes   String?
  estimatedPrice Float
  finalPrice     Float?
  paymentStatus  String   @default("PENDING") // PENDING, PAID, PARTIALLY_PAID, REFUNDED
  paymentMethod  String?
  beforePhotos   String   @default("[]") // JSON array
  afterPhotos    String   @default("[]") // JSON array
  completionNote String?
  cancelReason   String?
  promoCodeId    String?
  discountAmount Float    @default(0)

  // Lifecycle Timestamps
  assignedAt     DateTime?
  acceptedAt     DateTime?
  startedAt      DateTime?
  completedAt    DateTime?
  cancelledAt    DateTime?
  refundedAt     DateTime?

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // Relations
  customer     User          @relation("CustomerBookings", fields: [customerId], references: [id])
  professional Professional? @relation("ProfessionalBookings", fields: [professionalId], references: [id])
  service      Service       @relation(fields: [serviceId], references: [id])
  promoCode    PromoCode?    @relation(fields: [promoCodeId], references: [id])
  payments     Payment[]
  review       Review?
  dispute      Dispute?
  replacementParts ReplacementPart[]
}

// ============================================
// PAYMENTS
// ============================================

model Payment {
  id        String   @id @default(cuid())
  bookingId String
  userId    String
  amount    Float
  currency  String   @default("NGN")
  provider  String   @default("PAYSTACK") // PAYSTACK, MONNIFY, FLUTTERWAVE, WALLET
  reference String   @unique
  status    String   @default("PENDING") // PENDING, SUCCESS, FAILED, REFUNDED
  metadata  String   @default("{}") // JSON
  createdAt DateTime @default(now())

  booking Booking @relation(fields: [bookingId], references: [id])
  user    User    @relation(fields: [userId], references: [id])
}

// ============================================
// REVIEWS
// ============================================

model Review {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  customerId     String
  professionalId String
  rating         Int // 1-5
  comment        String?
  photos         String   @default("[]") // JSON array
  createdAt      DateTime @default(now())

  booking      Booking      @relation(fields: [bookingId], references: [id])
  customer     User         @relation("CustomerReviews", fields: [customerId], references: [id])
  professional Professional @relation("ProfessionalReviews", fields: [professionalId], references: [id])
}

// ============================================
// COMPLAINTS & DISPUTES
// ============================================

model Dispute {
  id              String    @id @default(cuid())
  reference       String    @unique @default(cuid())
  bookingId       String    @unique
  customerId      String
  professionalId  String
  assignedToId    String?
  reason          String    // POOR_WORKMANSHIP, PROPERTY_DAMAGE, LATE_ARRIVAL, NO_SHOW, OVERCHARGING, OTHER
  description     String
  evidencePhotos  String    @default("[]") // JSON array
  status          String    @default("OPEN") // OPEN, UNDER_REVIEW, RESOLVED_REFUNDED, RESOLVED_REJECTED, RESOLVED_PARTIAL_REFUND
  refundAmount    Float?    @default(0)
  resolutionNotes String?
  resolvedAt      DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  booking      Booking      @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer     User         @relation("CustomerDisputes", fields: [customerId], references: [id], onDelete: Cascade)
  professional Professional @relation("ProfessionalDisputes", fields: [professionalId], references: [id], onDelete: Cascade)
  assignedTo   User?        @relation("AdminDisputes", fields: [assignedToId], references: [id])
}

// ============================================
// ADDRESSES
// ============================================

model Address {
  id        String  @id @default(cuid())
  userId    String
  label     String  @default("Home") // Home, Office, Other
  address   String
  city      String  @default("Abuja")
  state     String  @default("FCT")
  landmark  String?
  latitude  Float?
  longitude Float?
  isDefault Boolean @default(false)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// WALLET
// ============================================

model Wallet {
  id            String @id @default(cuid())
  userId        String @unique
  balance       Float  @default(0)
  pendingEscrow Float  @default(0)
  currency      String @default("NGN")

  user         User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  transactions WalletTransaction[]
  withdrawals  WithdrawalRequest[]
}

model WalletTransaction {
  id          String   @id @default(cuid())
  walletId    String
  type        String   // CREDIT, DEBIT, ESCROW_HOLD, ESCROW_RELEASE, REFUND
  amount      Float
  description String
  reference   String?
  gateway     String?  // PAYSTACK, MONNIFY, FLUTTERWAVE, WALLET
  createdAt   DateTime @default(now())

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

model WithdrawalRequest {
  id            String   @id @default(cuid())
  walletId      String
  amount        Float
  bankCode      String
  bankName      String
  accountNumber String
  accountName   String
  status        String   @default("PENDING") // PENDING, PROCESSING, COMPLETED, FAILED
  reference     String   @unique
  transferCode  String?
  failureReason String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
}

// ============================================
// NOTIFICATIONS
// ============================================

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String   @default("SYSTEM") // BOOKING, PAYMENT, DISPUTE, VERIFICATION, SYSTEM, PROMO
  title     String
  message   String
  isRead    Boolean  @default(false)
  data      String?  // JSON
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

// ============================================
// PROMO CODES
// ============================================

model PromoCode {
  id            String    @id @default(cuid())
  code          String    @unique
  discountType  String    @default("PERCENTAGE") // PERCENTAGE, FIXED
  discountValue Float
  maxUses       Int       @default(100)
  usedCount     Int       @default(0)
  minAmount     Float     @default(0)
  maxDiscount   Float?
  expiresAt     DateTime
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())

  bookings Booking[]
}

// ============================================
// AUDIT LOG
// ============================================

model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  entity    String
  entityId  String?
  details   String?  // JSON
  ipAddress String?
  createdAt DateTime @default(now())
}

// ============================================
// SYSTEM SETTINGS & CONFIGURATION
// ============================================

model Setting {
  id        String   @id @default(cuid())
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

// ============================================
// REPLACEMENT PARTS & PROCUREMENT
// ============================================

model ReplacementPart {
  id                      String    @id @default(cuid())
  reference               String    @unique @default(cuid()) // e.g. HHP-PART-8492
  bookingId               String
  customerId              String
  professionalId          String
  supplierId              String?

  partName                String
  partNumber              String?
  category                String    @default("GENERAL") // PLUMBING, ELECTRICAL, HVAC, CARPENTRY, APPLIANCE, GENERAL
  description             String?
  reason                  String    // BURNT_OUT, CORRODED_LEAKING, MECHANICAL_WEAR, MISSING, INCOMPATIBLE, UPGRADE_REQUIRED, OTHER
  quantity                Int       @default(1)
  estimatedCost           Float
  approvedCost            Float?

  // Media Evidence
  evidencePhotos          String    @default("[]") // JSON array of damaged part photos
  receiptPhotos           String    @default("[]") // JSON array of merchant receipt photos
  receiptHash             String?   // SHA-256 hash to prevent duplicate receipt fraud
  installedPhotos         String    @default("[]") // JSON array of installed part photos

  // Lifecycle & Status
  status                  String    @default("REQUESTED") 
  // REQUESTED, APPROVED, REJECTED, VOUCHER_ISSUED, PURCHASED, INSTALLED_VERIFIED, CANCELLED, FLAGGED_FRAUD

  customerRejectionReason String?
  adminNotes              String?

  // Dedicated Procurement & Fast Supplier Disbursement (Second Account)
  destinationAccount      String    @default("PROCUREMENT_ACCOUNT") // PROCUREMENT_ACCOUNT (Decoupled from Service Escrow)
  paymentStatus           String    @default("PENDING") // PENDING, DIRECT_PROCUREMENT_PAID, DISBURSED_TO_SUPPLIER, REFUNDED
  paymentMethod           String?   // PAYSTACK, WALLET
  paymentReference        String?
  disbursementStatus      String    @default("PENDING_DISBURSEMENT") // PENDING_DISBURSEMENT, DISBURSED_TO_SUPPLIER, SETTLED
  disbursementReference   String?
  disbursedAt             DateTime?

  // One-Time Purchase Voucher
  voucherCode             String?   @unique // Cryptographic redemption code e.g. HHP-VOUCH-94821
  voucherExpiresAt        DateTime?
  voucherRedeemedAt       DateTime?
  voucherRedeemedBy       String?

  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt

  // Relations
  booking                 Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  customer                User          @relation("CustomerParts", fields: [customerId], references: [id])
  professional            Professional  @relation("ProfessionalParts", fields: [professionalId], references: [id])
  supplier                PartSupplier? @relation(fields: [supplierId], references: [id])
  auditLogs               PartAuditLog[]
}

model PartSupplier {
  id                    String    @id @default(cuid())
  name                  String
  category              String    @default("GENERAL") // PLUMBING, ELECTRICAL, HVAC, CARPENTRY, GENERAL
  contactPerson         String?
  phone                 String
  email                 String?
  address               String
  city                  String    @default("Abuja")
  state                 String    @default("FCT")
  bankName              String?
  bankAccount           String?
  accountName           String?
  paystackRecipientCode String?   // Paystack transfer recipient code for instant disbursement
  totalDisbursedNgn     Float     @default(0)
  settlementType        String    @default("INSTANT_TRANSFER") // INSTANT_TRANSFER, DIRECT_SETTLEMENT
  isVerified            Boolean   @default(true)
  rating                Float     @default(5.0)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  replacementParts ReplacementPart[]
}

model PartAuditLog {
  id             String    @id @default(cuid())
  partId         String
  actorId        String?
  actorRole      String    // ARTISAN, CUSTOMER, ADMIN, SYSTEM
  action         String    // REQUESTED, APPROVED, REJECTED, PAID, VOUCHER_ISSUED, VOUCHER_REDEEMED, INSTALLED, FLAGGED_FRAUD
  notes          String?
  metadata       String?   // JSON
  ipAddress      String?
  createdAt      DateTime  @default(now())

  replacementPart ReplacementPart @relation(fields: [partId], references: [id], onDelete: Cascade)
}

// ============================================
// MARKETPLACE & MERCHANT MODELS
// ============================================

model Merchant {
  id                    String    @id @default(cuid())
  userId                String    @unique
  businessName          String
  slug                  String    @unique
  cacNumber             String?
  businessAddress       String
  city                  String    @default("Abuja")
  state                 String    @default("FCT")
  latitude              Float?
  longitude             Float?
  phone                 String
  email                 String?
  bankName              String?
  bankAccount           String?
  accountName           String?
  paystackRecipientCode String?   // Paystack transfer recipient code for instant disbursement
  logoUrl               String?
  storePhotoUrl         String?
  
  // Verification & Compliance
  verificationStatus    String    @default("PENDING") // PENDING, VERIFIED, REJECTED, SUSPENDED
  verificationNotes     String?
  verifiedAt            DateTime?

  // Monthly Subscription
  subscriptionStatus    String    @default("PENDING_PAYMENT") // ACTIVE, TRIAL, EXPIRED, SUSPENDED, CANCELLED
  subscriptionPlan      String    @default("STANDARD_MONTHLY") // STANDARD_MONTHLY (₦15,000/mo), PREMIUM_MONTHLY
  subscriptionAmount    Float     @default(15000)
  subscriptionStartedAt DateTime?
  subscriptionExpiresAt DateTime?
  lastPaymentReference  String?

  rating                Float     @default(5.0)
  totalOrders           Int       @default(0)
  isActive              Boolean   @default(true)
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  products              MarketplaceProduct[]
  subscriptionInvoices  MerchantSubscriptionInvoice[]
  orderItems            MarketplaceOrderItem[]
}

model MerchantSubscriptionInvoice {
  id                String    @id @default(cuid())
  merchantId        String
  amount            Float
  periodStart       DateTime
  periodEnd         DateTime
  status            String    @default("PAID") // PAID, PENDING, OVERDUE, CANCELLED
  paystackReference String?   @unique
  paidAt            DateTime?
  createdAt         DateTime  @default(now())

  merchant          Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
}

model MarketplaceCategory {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  icon        String?
  description String?
  type        String    @default("REPLACEMENT_PARTS") // REPLACEMENT_PARTS (Phase 1 Active), TOOLS, MATERIALS, EQUIPMENT
  isActive    Boolean   @default(true)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())

  products    MarketplaceProduct[]
}

model MarketplaceProduct {
  id                String    @id @default(cuid())
  merchantId        String
  categoryId        String
  sku               String    @unique
  title             String
  slug              String    @unique
  description       String
  partNumber        String?
  brand             String?
  compatibility     String    @default("[]") // JSON array of supported equipment/models
  specifications    String    @default("{}") // JSON key-values (voltage, material, size)
  price             Float
  compareAtPrice    Float?
  costPrice         Float?
  stockQuantity     Int       @default(0)
  lowStockThreshold Int       @default(5)
  images            String    @default("[]") // JSON array of product image URLs
  weightKg          Float     @default(0.5)
  dimensions        String?
  status            String    @default("ACTIVE") // DRAFT, ACTIVE, OUT_OF_STOCK, SUSPENDED
  isVerified        Boolean   @default(true)
  
  // Fraud & Price Anomaly Detection
  priceAnomalyFlag  Boolean   @default(false)
  medianMarketPrice Float?
  
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  merchant          Merchant            @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  category          MarketplaceCategory @relation(fields: [categoryId], references: [id])
  reservations      InventoryReservation[]
  orderItems        MarketplaceOrderItem[]
}

model InventoryReservation {
  id             String    @id @default(cuid())
  productId      String
  customerId     String
  cartSessionId  String
  quantity       Int       @default(1)
  reservedUntil  DateTime  // 15-minute TTL lock window
  status         String    @default("RESERVED") // RESERVED, COMMITTED, RELEASED
  createdAt      DateTime  @default(now())

  product        MarketplaceProduct @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model MarketplaceOrder {
  id                    String    @id @default(cuid())
  orderNumber           String    @unique // e.g. HHP-MKT-94821
  customerId            String
  procurementType       String    @default("DIRECT_PURCHASE") // DIRECT_PURCHASE, AUTO_PROCUREMENT
  status                String    @default("PENDING_PAYMENT") 
  // PENDING_PAYMENT, PAID, PROCESSING, READY_FOR_PICKUP, IN_TRANSIT, DELIVERED, CANCELLED, REFUNDED

  subtotal              Float
  logisticsFee          Float     @default(0)
  totalAmount           Float

  destinationAccount    String    @default("PROCUREMENT_ACCOUNT")
  paymentStatus         String    @default("PENDING") // PENDING, PAID, ESCROW_HOLD, DISBURSED, REFUNDED
  paymentMethod         String?   // PAYSTACK, WALLET
  paymentReference      String?

  deliveryAddress       String    // JSON / Street address
  deliveryCity          String    @default("Abuja")
  deliveryState         String    @default("FCT")
  deliveryLatitude      Float?
  deliveryLongitude     Float?
  
  deliveryPartner       String?   @default("HandyHub Priority Dispatch")
  trackingNumber        String?   @unique
  deliveryOtp           String?   // 6-digit confirmation PIN
  otpVerified           Boolean   @default(false)
  estimatedDeliveryTime DateTime?
  deliveredAt           DateTime?

  customerNotes         String?
  invoiceHash           String?   // Duplicate invoice detection SHA-256

  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  customer              User      @relation(fields: [customerId], references: [id])
  items                 MarketplaceOrderItem[]
  logisticsTrackings    MarketplaceLogisticsTracking[]
  auditLogs             MarketplaceAuditLog[]
}

model MarketplaceOrderItem {
  id                    String    @id @default(cuid())
  orderId               String
  productId             String
  merchantId            String
  unitPrice             Float
  quantity              Int
  totalPrice            Float
  
  merchantPayoutStatus  String    @default("ESCROW_HOLD") // PENDING, ESCROW_HOLD, DISBURSED, REFUNDED
  merchantPayoutAmount  Float
  disbursedAt           DateTime?
  disbursementReference String?

  order                 MarketplaceOrder   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product               MarketplaceProduct @relation(fields: [productId], references: [id])
  merchant              Merchant           @relation(fields: [merchantId], references: [id])
}

model MarketplaceLogisticsTracking {
  id           String    @id @default(cuid())
  orderId      String
  status       String    // ORDER_CONFIRMED, MERCHANT_PACKED, DISPATCH_ASSIGNED, IN_TRANSIT, DELIVERED
  locationName String
  notes        String?
  riderName    String?
  riderPhone   String?
  timestamp    DateTime  @default(now())

  order        MarketplaceOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model MarketplaceAuditLog {
  id        String   @id @default(cuid())
  orderId   String?
  merchantId String?
  productId String?
  actorId   String?
  actorRole String   // CUSTOMER, MERCHANT, ADMIN, SYSTEM
  action    String   // ORDER_PLACED, INVENTORY_RESERVED, AUTO_PROCURED, DELIVERY_CONFIRMED, PRICE_FLAGGED, SUBSCRIPTION_RENEWED
  details   String?  // JSON
  ipAddress String?
  createdAt DateTime @default(now())

  order     MarketplaceOrder? @relation(fields: [orderId], references: [id], onDelete: Cascade)
}



